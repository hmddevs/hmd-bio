# MongoDB Atlas
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/hmdbio?retryWrites=true&w=majority

# NextAuth
AUTH_SECRET=generate-a-secret-with-openssl-rand-base64-32
AUTH_URL=https://hmd.bio

# Cloudflare Turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Internal middleware → API secret
INTERNAL_SECRET=generate-a-secret-for-internal-calls

# IP hashing salt (GDPR)
IP_HASH_SALT=generate-a-random-salt

# IP encryption key (32 bytes = 64 hex chars) for admin raw IP access
IP_ENCRYPTION_KEY=generate-a-64-char-hex-string

# Sentry (optional)
SENTRY_DSN=

# Upstash Redis (optional — caching & rate limits)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Resend (optional — verification emails)
RESEND_API_KEY=

# Admin notification email (optional)
ADMIN_EMAIL=

# ── Custom domains ──
# The platform's own domain. Every link created without an explicit domain
# belongs to this one, and a custom host is anything that is not this.
NEXT_PUBLIC_PRIMARY_DOMAIN=hmd.bio

# Vercel REST API, used to attach and detach user domains and to read
# certificate status. The token needs domain read/write on the project below.
# Create one at https://vercel.com/account/settings/tokens
VERCEL_API_TOKEN=
VERCEL_PROJECT_ID=
# Only needed when the project belongs to a team rather than a personal account.
VERCEL_TEAM_ID=

# Authorises the daily domain re-verification cron. Vercel Cron sends this as
# `Authorization: Bearer <value>`, which is why this is separate from
# INTERNAL_SECRET (Vercel Cron cannot send custom headers).
CRON_SECRET=

# How many domains a single user may attach (optional, defaults to 3).
MAX_DOMAINS_PER_USER=3
